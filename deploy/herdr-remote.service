[Unit]
Description=herdr remote — phone and browser view of herdr agents

[Service]
WorkingDirectory=%h/herdr-remote
EnvironmentFile=%h/.config/herdr-remote/env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/bun run server/main.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
