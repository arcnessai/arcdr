# Tailscale logins allowed in, comma-separated. Whoever is let in can type into the agents' terminals.
HR_OWNERS=you@example.com
# The name tailscale serve publishes this under (with :port when it is not 443).
HR_PUBLIC_HOSTS=machine.tailnet.ts.net
# Shown on the connect screen.
HR_MACHINE=machine
# Optional: HR_HOST (loopback only, default 127.0.0.2), HR_PORT (default 7420),
# HR_TRANSCRIPT_ROOTS (default ~/.claude/projects), HERDR_SOCKET_PATH (default ~/.config/herdr/herdr.sock).
