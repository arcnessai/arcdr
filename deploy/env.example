# Tailscale logins allowed in, comma-separated. Whoever is let in can type into the agents' terminals.
ARCDR_OWNERS=you@example.com
# The name tailscale serve publishes this under (with :port when it is not 443).
ARCDR_PUBLIC_HOSTS=machine.tailnet.ts.net
# Shown on the connect screen.
ARCDR_MACHINE=machine
# Optional: ARCDR_HOST (loopback only, default 127.0.0.2), ARCDR_PORT (default 7420),
# ARCDR_TRANSCRIPT_ROOTS (default ~/.claude/projects), HERDR_SOCKET_PATH (default ~/.config/herdr/herdr.sock).
