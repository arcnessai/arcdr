# Template: scripts/setup.sh fills the @…@ values and installs it as ~/.config/systemd/user/arcdr.service.
[Unit]
Description=arcdr — herdr agents on your phone and in the browser

[Service]
WorkingDirectory=@ROOT@
EnvironmentFile=@ENV_FILE@
Environment=PATH=@PATH@
ExecStart=@BUN@ run server/main.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
