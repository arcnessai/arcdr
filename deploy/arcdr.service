[Unit]
Description=arcdr — herdr agents on your phone and in the browser

[Service]
WorkingDirectory=%h/arcdr
EnvironmentFile=%h/.config/arcdr/env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/bun run server/main.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
