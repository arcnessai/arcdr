{
  "name": "arcdr",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "start": "bun run server/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write server web scripts/*.ts",
    "check": "prettier --check server web scripts/*.ts && tsc --noEmit && bun test",
    "demo": "bun run scripts/build.ts && bun run scripts/demo.ts"
  },
  "dependencies": {
    "preact": "11.0.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/web-push": "3.6.4",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
